---
interface MetricItem {
  value: string;
  label: string;
}

interface Props {
  slug: string;
  index: string;
  title: string;
  context: string;
  period: string;
  status: 'Active' | 'Completed' | 'Ongoing';
  summary: string;
  outcome: string;
  metrics: MetricItem[];
  stack: string[];
}

const { slug, index, title, context, period, status, summary, outcome, metrics, stack } =
  Astro.props;
const visibleStack = stack.slice(0, 6);
const extraCount = Math.max(0, stack.length - visibleStack.length);
---

<article
  data-deck-slide
  class="group flex w-full shrink-0 snap-start snap-always flex-col"
>
  <a
    href={`/projects/${slug}`}
    class="grid flex-1 grid-cols-1 gap-6 border-t border-line px-4 py-8 transition-all duration-200 hover:border-signal hover:bg-surface sm:px-6 md:grid-cols-12 md:gap-8"
  >
    <!-- Left Identity Column -->
    <div class="flex flex-col justify-between gap-6 md:col-span-5">
      <div class="space-y-4">
        <div class="flex items-center justify-between gap-3">
          <span class="font-mono text-xs text-ink-muted transition-colors duration-150 group-hover:text-signal">
            {index}
          </span>
          <span class="border border-line px-2 py-0.5 font-mono text-[10px] tracking-[0.12em] text-ink-secondary uppercase">
            {status}
          </span>
        </div>

        <div class="space-y-1.5">
          <p class="font-mono text-[11px] tracking-wider text-ink-muted uppercase">
            {context} · {period}
          </p>
          <h3 class="text-xl font-medium leading-snug tracking-tight text-ink transition-colors duration-150 group-hover:text-signal sm:text-2xl">
            {title}
          </h3>
        </div>
      </div>

      <div>
        <span class="inline-flex items-center gap-2 border border-line-strong bg-canvas px-3 py-1.5 font-mono text-[10px] tracking-[0.12em] text-ink-secondary uppercase transition-colors duration-150 group-hover:border-signal group-hover:text-signal">
          <span>Open case study</span>
          <span
            class="transition-transform duration-150 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
            aria-hidden="true"
          >
            ↗
          </span>
        </span>
      </div>
    </div>

    <!-- Right Case Study Preview Column -->
    <div class="flex flex-col justify-between gap-5 border-t border-line pt-5 md:col-span-7 md:border-t-0 md:border-l md:pt-0 md:pl-8">
      <div class="space-y-4">
        <p class="text-sm leading-relaxed text-ink-secondary">
          {summary}
        </p>

        <div class="border-l border-line-strong pl-3 transition-colors duration-150 group-hover:border-signal">
          <p class="text-xs leading-relaxed text-ink">
            {outcome}
          </p>
        </div>

        {
          metrics.length > 0 && (
            <dl class="grid grid-cols-3 border-y border-line divide-x divide-line">
              {metrics.map((metric) => (
                <div class="px-3 py-2.5 first:pl-0">
                  <dt class="font-mono text-[9px] leading-tight tracking-[0.06em] text-ink-muted uppercase">
                    {metric.label}
                  </dt>
                  <dd class="mt-0.5 font-mono text-xs font-medium text-ink tabular-nums sm:text-sm">
                    {metric.value}
                  </dd>
                </div>
              ))}
            </dl>
          )
        }
      </div>

      {
        visibleStack.length > 0 && (
          <ul class="flex flex-wrap gap-1.5" aria-label="Core stack">
            {visibleStack.map((item) => (
              <li class="border border-line px-2 py-0.5 font-mono text-[10px] tracking-wider text-ink-muted uppercase">
                {item}
              </li>
            ))}
            {extraCount > 0 && (
              <li class="border border-line px-2 py-0.5 font-mono text-[10px] tracking-wider text-ink-muted uppercase">
                +{extraCount}
              </li>
            )}
          </ul>
        )
      }
    </div>
  </a>
</article>
