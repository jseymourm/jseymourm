---
interface Props {
  class?: string;
}

const { class: className = 'h-7 w-7' } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 16 16"
  shape-rendering="crispEdges"
  fill="none"
  aria-hidden="true"
  class={className}
>
  <!-- Signal yellow pixel steam wisps -->
  <rect x="5" y="1" width="1" height="1" fill="#FACC15" />
  <rect x="6" y="2" width="1" height="1" fill="#FACC15" />
  <rect x="5" y="3" width="1" height="1" fill="#FACC15" />

  <rect x="9" y="1" width="1" height="1" fill="#FACC15" />
  <rect x="8" y="2" width="1" height="1" fill="#FACC15" />
  <rect x="9" y="3" width="1" height="1" fill="#FACC15" />

  <!-- Monochrome white pixel mug rim & body -->
  <rect x="3" y="5" width="8" height="1" fill="#FAFAFA" />
  <rect x="3" y="6" width="1" height="6" fill="#FAFAFA" />
  <rect x="10" y="6" width="1" height="6" fill="#FAFAFA" />
  <rect x="4" y="12" width="6" height="1" fill="#FAFAFA" />

  <!-- Subtle coffee fill inside mug -->
  <rect x="4" y="7" width="6" height="4" fill="#FAFAFA" fill-opacity="0.16" />

  <!-- Pixel mug handle -->
  <rect x="11" y="7" width="2" height="1" fill="#FAFAFA" />
  <rect x="12" y="8" width="1" height="2" fill="#FAFAFA" />
  <rect x="11" y="10" width="2" height="1" fill="#FAFAFA" />

  <!-- Minimal pixel saucer -->
  <rect x="2" y="14" width="10" height="1" fill="#FAFAFA" fill-opacity="0.5" />
</svg>
