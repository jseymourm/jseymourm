---
import { SITE } from '@/data/site';
---

<header class="sticky top-0 z-40 bg-canvas/90 backdrop-blur-sm">
  <div class="mx-auto flex w-full max-w-[var(--spacing-frame)] flex-col items-center justify-center gap-3 px-4 py-5 sm:px-6 lg:px-12">
    <a
      href="/"
      class="font-mono text-base font-medium tracking-tight text-ink transition-colors duration-150 hover:text-signal"
      aria-label={`${SITE.name} home`}
    >
      {SITE.brand}
    </a>

    <!-- Compact mobile/tablet navigation (hidden on desktop where LeftNav takes over) -->
    <nav aria-label="Mobile section navigation" class="lg:hidden">
      <ul class="flex flex-wrap items-center justify-center gap-x-4 gap-y-1.5">
        {
          SITE.navigation.map((item) => (
            <li>
              <a
                href={item.href}
                class="font-mono text-[11px] tracking-[0.08em] text-ink-secondary uppercase transition-colors duration-150 hover:text-signal"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
