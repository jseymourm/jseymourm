---
interface Props {
  index: string;
  label: string;
  meta?: string;
}

const { index, label, meta } = Astro.props;
---

<div class="flex items-center justify-between border-b border-line pb-4">
  <h2 class="flex items-center gap-3 font-mono text-[length:var(--text-micro)] tracking-[0.14em] text-ink uppercase">
    <span class="text-ink-muted">{index}</span>
    <span class="h-px w-4 bg-line-strong" aria-hidden="true"></span>
    <span>{label}</span>
  </h2>

  {
    meta && (
      <span class="font-mono text-[length:var(--text-micro)] tracking-[0.12em] text-ink-muted uppercase">
        {meta}
      </span>
    )
  }
</div>
