---
interface RoleItem {
  title: string;
  period: string;
  focus: string;
  promoted?: boolean;
}

interface MetricItem {
  value: string;
  label: string;
}

interface Props {
  slug: string;
  index: string;
  company: string;
  logo?: string;
  location: string;
  period: string;
  current: boolean;
  summary: string;
  roles: RoleItem[];
  metrics: MetricItem[];
}

const { slug, index, company, logo, location, period, current, summary, roles, metrics } =
  Astro.props;
---

<article
  data-deck-slide
  class="group flex w-full shrink-0 snap-start snap-always flex-col"
>
  <a
    href={`/experience/${slug}`}
    class="grid flex-1 grid-cols-1 gap-6 border-t border-line px-4 py-8 transition-all duration-200 hover:border-signal hover:bg-surface sm:px-6 md:grid-cols-12 md:gap-8"
  >
    <!-- Left Identity & Meta Column -->
    <div class="flex flex-col justify-between gap-6 md:col-span-5">
      <div class="space-y-5">
        <div class="flex flex-wrap items-center gap-2.5">
          <span class="font-mono text-xs text-ink-muted transition-colors duration-150 group-hover:text-signal">
            {index}
          </span>
          <span class="h-3 w-px bg-line" aria-hidden="true"></span>
          <p class="font-mono text-xs text-ink-secondary">{period}</p>
          {
            current && (
              <span class="inline-flex items-center gap-1.5 border border-line-strong px-1.5 py-0.5 font-mono text-[10px] tracking-[0.12em] text-ink uppercase">
                <span class="h-1.5 w-1.5 rounded-full bg-signal" aria-hidden="true" />
                Current
              </span>
            )
          }
        </div>

        <div class="flex items-center gap-4">
          {
            logo && (
              <div class="flex h-12 w-12 shrink-0 items-center justify-center overflow-hidden rounded-full bg-surface">
                <img
                  src={logo}
                  alt={`${company} logo`}
                  width="48"
                  height="48"
                  loading="lazy"
                  class="h-12 w-12 object-contain"
                />
              </div>
            )
          }
          <div class="min-w-0 space-y-0.5">
            <h3 class="text-xl font-medium tracking-tight text-ink transition-colors duration-150 group-hover:text-signal sm:text-2xl">
              {company}
            </h3>
            <p class="font-mono text-[11px] tracking-wider text-ink-muted uppercase">
              {location}
            </p>
          </div>
        </div>
      </div>

      <div>
        <span class="inline-flex items-center gap-2 border border-line-strong bg-canvas px-3 py-1.5 font-mono text-[10px] tracking-[0.12em] text-ink-secondary uppercase transition-colors duration-150 group-hover:border-signal group-hover:text-signal">
          <span>Read notes</span>
          <span
            class="transition-transform duration-150 group-hover:translate-x-0.5"
            aria-hidden="true"
          >
            →
          </span>
        </span>
      </div>
    </div>

    <!-- Right Experience Details Column -->
    <div class="flex flex-col justify-between gap-5 border-t border-line pt-5 md:col-span-7 md:border-t-0 md:border-l md:pt-0 md:pl-8">
      <div class="space-y-4">
        <ol class="space-y-2.5 border-l border-line pl-3.5">
          {
            roles.map((role) => (
              <li class="space-y-0.5">
                <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                  <span class="text-sm font-medium text-ink">{role.title}</span>
                  {role.promoted && (
                    <span class="border border-line px-1.5 py-0.5 font-mono text-[9px] tracking-[0.1em] text-ink-secondary uppercase">
                      Promoted
                    </span>
                  )}
                </div>
                <p class="text-xs leading-relaxed text-ink-muted">{role.focus}</p>
              </li>
            ))
          }
        </ol>

        <p class="text-sm leading-relaxed text-ink-secondary">
          {summary}
        </p>
      </div>

      {
        metrics.length > 0 && (
          <dl class="grid grid-cols-3 border-y border-line divide-x divide-line">
            {metrics.map((metric) => (
              <div class="px-3 py-2.5 first:pl-0">
                <dt class="font-mono text-[9px] tracking-[0.08em] text-ink-muted uppercase">
                  {metric.label}
                </dt>
                <dd class="mt-0.5 font-mono text-xs font-medium tracking-tight text-ink tabular-nums sm:text-sm">
                  {metric.value}
                </dd>
              </div>
            ))}
          </dl>
        )
      }
    </div>
  </a>
</article>
