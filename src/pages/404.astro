---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/data/site';
---

<BaseLayout title={`404 — ${SITE.brand}`} description="Page not found.">
  <section class="flex min-h-[60dvh] flex-col items-center justify-center py-20 text-center">
    <p class="font-mono text-xs tracking-[0.14em] text-ink-muted uppercase">Error 404</p>
    <h1 class="mt-3 text-[length:var(--text-display)] font-medium text-ink">
      Route not found.
    </h1>
    <p class="mt-4 max-w-md text-sm leading-relaxed text-ink-secondary">
      The requested path does not exist on this site. Return to the index to view experience
      entries and case studies.
    </p>
    <div class="mt-8">
      <a
        href="/"
        class="group inline-flex items-center gap-2 border border-line-strong bg-canvas px-4 py-2 font-mono text-xs tracking-[0.08em] text-ink uppercase transition-colors duration-150 hover:border-signal hover:text-signal"
      >
        <span class="transition-transform duration-150 group-hover:-translate-x-0.5" aria-hidden="true">←</span>
        <span>Back to Index</span>
      </a>
    </div>
  </section>
</BaseLayout>
