---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/data/site';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort(
    (a, b) => a.data.order - b.data.order,
  );

  return projects.map((project, idx) => ({
    params: { slug: project.id },
    props: {
      project,
      prev: projects[idx - 1] ?? null,
      next: projects[idx + 1] ?? null,
    },
  }));
}

const { project, prev, next } = Astro.props;
const { Content } = await render(project);
const { title, context, period, status, summary, outcome, metrics, stack, repoUrl, liveUrl } =
  project.data;
---

<BaseLayout
  title={`${title} — ${SITE.name}`}
  description={summary}
>
  <div class="space-y-12 sm:space-y-16">
    <!-- Case Study Header (Open outside, internal hairlines retained) -->
    <div>
      <!-- Top Breadcrumb Bar -->
      <div class="flex items-center justify-between border-b border-line pb-4">
        <a
          href="/#projects"
          class="group inline-flex items-center gap-2 border border-line-strong bg-canvas px-2.5 py-1 font-mono text-[11px] tracking-[0.1em] text-ink-secondary uppercase transition-colors duration-150 hover:border-signal hover:text-signal"
        >
          <span class="transition-transform duration-150 group-hover:-translate-x-0.5" aria-hidden="true">←</span>
          <span>Projects</span>
        </a>
        <span class="border border-line px-2 py-0.5 font-mono text-[10px] tracking-[0.12em] text-ink-secondary uppercase">
          {status}
        </span>
      </div>

      <!-- Case Study Header Content -->
      <header class="border-b border-line py-10 sm:py-14">
        <p class="font-mono text-[11px] tracking-[0.12em] text-ink-muted uppercase">
          {context} · {period}
        </p>

        <h1 class="mt-3 max-w-3xl text-[length:var(--text-display)] font-medium text-ink">
          {title}
        </h1>

        <p class="mt-5 max-w-2xl text-base leading-relaxed text-ink-secondary">
          {summary}
        </p>

        <!-- Metrics Strip (internal dividers only) -->
        {
          metrics.length > 0 && (
            <dl class="mt-8 grid grid-cols-1 border-y border-line divide-y divide-line sm:grid-cols-3 sm:divide-x sm:divide-y-0">
              {metrics.map((metric) => (
                <div class="py-4 sm:px-4 sm:first:pl-0">
                  <dt class="font-mono text-[10px] tracking-[0.14em] text-ink-muted uppercase">
                    {metric.label}
                  </dt>
                  <dd class="mt-1 font-mono text-xl font-medium tracking-tight text-ink tabular-nums">
                    {metric.value}
                  </dd>
                </div>
              ))}
            </dl>
          )
        }

        <!-- Outcome & Metadata Grid (internal dividers only) -->
        <div class="grid grid-cols-1 border-b border-line divide-y divide-line md:grid-cols-12 md:divide-x md:divide-y-0">
          <div class="py-5 md:col-span-7 md:pr-6">
            <p class="font-mono text-[10px] tracking-[0.14em] text-ink-muted uppercase">Outcome</p>
            <p class="mt-1.5 text-sm leading-relaxed text-ink">{outcome}</p>
          </div>
          <div class="py-5 md:col-span-5 md:pl-6">
            <p class="font-mono text-[10px] tracking-[0.14em] text-ink-muted uppercase">
              Stack & Domains
            </p>
            <ul class="mt-2 flex flex-wrap gap-1.5">
              {
                stack.map((item) => (
                  <li class="border border-line px-2 py-0.5 font-mono text-[10px] tracking-wider text-ink-secondary uppercase">
                    {item}
                  </li>
                ))
              }
            </ul>
          </div>
        </div>

        {
          (repoUrl || liveUrl) && (
            <div class="mt-6 flex flex-wrap gap-3">
              {repoUrl && (
                <a
                  href={repoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group inline-flex items-center gap-2 border border-line-strong bg-canvas px-3.5 py-2 font-mono text-xs tracking-[0.08em] text-ink uppercase transition-colors duration-150 hover:border-signal hover:text-signal"
                >
                  <span>Source Repository</span>
                  <span class="transition-transform duration-150 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true">↗</span>
                </a>
              )}
              {liveUrl && (
                <a
                  href={liveUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group inline-flex items-center gap-2 border border-ink bg-ink px-3.5 py-2 font-mono text-xs tracking-[0.08em] text-canvas uppercase transition-colors duration-150 hover:border-signal hover:bg-signal hover:text-canvas"
                >
                  <span>Live Site</span>
                  <span class="transition-transform duration-150 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true">↗</span>
                </a>
              )}
            </div>
          )
        }
      </header>
    </div>

    <!-- MDX Body -->
    <article class="py-2">
      <div class="prose prose-invert prose-swiss max-w-2xl">
        <Content />
      </div>
    </article>

    <!-- Prev / Next Case Study -->
    <nav
      aria-label="Project pagination"
      class="grid grid-cols-1 border-t border-line divide-y divide-line sm:grid-cols-2 sm:divide-x sm:divide-y-0"
    >
      <div>
        {
          prev ? (
            <a
              href={`/projects/${prev.id}`}
              class="group flex h-full flex-col gap-1 border-l-2 border-l-transparent px-4 py-6 transition-all duration-150 hover:border-l-signal hover:bg-surface sm:px-6"
            >
              <span class="font-mono text-[10px] tracking-[0.14em] text-ink-muted uppercase transition-colors duration-150 group-hover:text-signal">
                ← Previous
              </span>
              <span class="text-sm font-medium text-ink transition-colors duration-150 group-hover:text-signal">
                {prev.data.title}
              </span>
            </a>
          ) : (
            <div class="px-4 py-6 font-mono text-[10px] tracking-[0.14em] text-ink-muted/50 uppercase sm:px-6">
              First case study
            </div>
          )
        }
      </div>
      <div>
        {
          next ? (
            <a
              href={`/projects/${next.id}`}
              class="group flex h-full flex-col gap-1 border-r-2 border-r-transparent px-4 py-6 text-left transition-all duration-150 hover:border-r-signal hover:bg-surface sm:px-6 sm:text-right"
            >
              <span class="font-mono text-[10px] tracking-[0.14em] text-ink-muted uppercase transition-colors duration-150 group-hover:text-signal">
                Next →
              </span>
              <span class="text-sm font-medium text-ink transition-colors duration-150 group-hover:text-signal">
                {next.data.title}
              </span>
            </a>
          ) : (
            <div class="px-4 py-6 font-mono text-[10px] tracking-[0.14em] text-ink-muted/50 uppercase sm:px-6 sm:text-right">
              End of case studies
            </div>
          )
        }
      </div>
    </nav>
  </div>
</BaseLayout>
